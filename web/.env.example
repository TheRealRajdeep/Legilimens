# --- Chain -------------------------------------------------------------
NEXT_PUBLIC_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
# Block the vault was deployed at (subgraph startBlock, event scans)
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK=0

# --- Agent (server only, never NEXT_PUBLIC) ----------------------------
# The Seer's wallet: signs startGame payloads, submits guesses, receives rake, pays its own gas.
AGENT_PRIVATE_KEY=0x
# Any long random string. Derives per-game seeds and signs eligibility tokens. Rotating it breaks in-flight games.
AGENT_SEED_SECRET=change-me-to-a-long-random-string
# Flat per-game compute fee recorded on-chain in addition to guess gas, in USDC wei (18 decimals). 0.001 USDC:
AGENT_COMPUTE_FEE_WEI=1000000000000000

# --- The Graph ---------------------------------------------------------
# Subgraph Studio query URL. Leave empty to use a uniform prior.
SUBGRAPH_URL=
NEXT_PUBLIC_SUBGRAPH_URL=

# LOCAL DEV ONLY: point app + server at a local anvil (anvil --chain-id 5042002). Leave empty for Arc testnet.
NEXT_PUBLIC_RPC_URL=
